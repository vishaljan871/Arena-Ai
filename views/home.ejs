<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport"
    content="width=device-width, initial-scale=1.0">
  
  <title>Arena AI | SAMS</title>
  
  <!-- Google Font -->
  <link rel="preconnect"
    href="https://fonts.googleapis.com">
  <link rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Red+Hat+Text:ital,wght@0,300..700;1,300..700&display=swap"
    rel="stylesheet">
  
  <!-- Font Awesome -->
  <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">
  
  <link rel="stylesheet"
    href="style.css">
</head>

<body>
  
  <section class="page page1">
    <div class="nav">
      <h1>Smart <span> Attendance
        </span>Management System</h1>
      <p>Your intelligent assistant for
        attendance management. Simple
        commands, smart interactions and
        effortless tracking.</p>
    </div>
    <div class="box">
      <div class="app-icon"></div>
      <p>Version 1.0.0 · Developed by
        Vishal Jain</p>
    </div>
    <div class="cards">
      <div class="card">
        <i
          class="fa-solid fa-hexagon-nodes"></i>
        <h2>AI Assistant</h2>
        <p>commands based interaction
        </p>
      </div>
      <div class="card">
        <i
          class="fa-solid fa-calendar-check"></i>
        <h2>Attendance</h2>
        <p>mark and view records</p>
      </div>
      <div class="card">
        <i
          class="fa-solid fa-microphone-lines"></i>
        <h2>Voice Chat</h2>
        <p>talk to ai & getting you info
        </p>
      </div>
    </div>
  </section>
  
  <section class="page page2">
    <h2>Learn the commands.</h1>
      <div class="cards">
        <div class="card">
          <div class="left">
            <h3>@register</h3>
            <p>Alternative: Not
              available</p>
          </div>
          <button>Guest only</button>
        </div>
        <div class="card">
          <div class="left">
            <h3>@login</h3>
            <p>Alternative: Not
              available</p>
          </div>
          <button>Guest only</button>
        </div>
        <div class="card">
          <div class="left">
            <h3>@mark_attendance</h3>
            <p>Alternative: @mark_atdns
            </p>
          </div>
          <button>Login
            required</button>
        </div>
        <div class="card">
          <div class="left">
            <h3>@show_attendance</h3>
            <p>Alternative: @show_atdns
            </p>
          </div>
          <button>Login
            required</button>
        </div>
        <div class="card">
          <div class="left">
            <h3>@change_password</h3>
            <p>Alternative: @change_pass
            </p>
          </div>
          <button>Login
            required</button>
        </div>
        <div class="card">
          <div class="left">
            <h3>@logout</h3>
            <p>Alternative: Not
              available</p>
          </div>
          <button>Login
            required</button>
        </div>
      </div>
  </section>
  
  <section class="page page3">
    <h2>This is just beginning.</h2>
    <p>Arena AI is only getting started.
      More intelligent features and a
      better experience are planned for
      upcoming versions.</p>
    <button class="future">Future
      updates</button>
    <ul>
      <li>Advanced AI voice assistant
      </li>
      <li>Attendance analytics and
        reports</li>
      <li>Smart notifications</li>
      <li>More AI-powered commands</li>
      <li>Improved dashboard</li>
      <li>Expenses traking</li>
      <li>Balance traking</li>
      <li>Digital currency and more
        features</li>
    </ul>
    
    <div class="app-box">
      <div class="app-icon"></div>
      <p>Version 1.0.0 · Developed by
        Vishal Jain</p>
      <button onclick="downloadApp()">Download APK</button>
    </div>
    
    <div class="box">
      <h1>Build with a vision.</h1>
      <h3>deployed by Vishal Jain</h3>
      <p>Arena AI · Version 1.0.0</p>
      <span>The beginning of something
        smarter.</span>
      <p>© 2026 Arena AI. All rights
        reserved.</p>
    </div>
  </section>
 
  <section class="page page4"></section>
  
  </section>
  
  <!-- Your JavaScript -->
  <script>
    function downloadApp() {
      window.location.href = "/downloads/Arena-AI.apk"
    }
  </script>
</body>

</html>
